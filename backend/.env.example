# Copy this file to backend/.env and fill in the values. Never commit .env.

# Model
MODEL_PATH=../ml/export/model.onnx
LABELS_PATH=../ml/export/labels.json
MODEL_VERSION=v1
CONFIDENCE_THRESHOLD=0.60

# Upload limits
MAX_UPLOAD_MB=8

# CORS (frontend origin)
CORS_ORIGINS=http://localhost:3000

# Supabase (Phase 2). SERVICE ROLE KEY IS SERVER-ONLY: never put it in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=plant-images

# Gemini (Phase 5), key from Google AI Studio. Server-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
