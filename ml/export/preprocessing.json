{
  "model_version": "mnv2-plantvillage-v1",
  "input_name": "input",
  "input_layout": "NCHW",
  "input_shape": [
    "batch",
    3,
    224,
    224
  ],
  "input_dtype": "float32",
  "color_mode": "RGB",
  "resize": {
    "width": 224,
    "height": 224,
    "method": "bilinear",
    "keep_aspect_ratio": false,
    "reference": "PIL.Image.resize((224, 224), Image.Resampling.BILINEAR)"
  },
  "divide_by": 255.0,
  "normalize": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "steps": [
    "open image",
    "convert to RGB",
    "resize to 224x224 (bilinear)",
    "float32 / 255",
    "(x - mean) / std per channel",
    "HWC -> CHW",
    "add batch dimension"
  ],
  "output_name": "probabilities",
  "output_note": "softmax already applied; shape (batch, num_classes); index order matches labels.json",
  "num_classes": 38
}